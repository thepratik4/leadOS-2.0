# LeadOS Backend Environment Configuration

# Application
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL recommended; fallback to SQLite supported for local testing)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/leados
# Example SQLite: sqlite+aiosqlite:///./leados.db
DATABASE_URL=sqlite+aiosqlite:///./leados.db

# Search Providers
# Available: "ddgs" (DuckDuckGo, default, no API key needed), "brave", "serpapi", "tavily"
SEARCH_PROVIDER=ddgs
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Optional AI Extraction (Gemini)
# If provided, Gemini assists in structured extraction, which is deterministically verified by the evidence engine.
# If omitted, LeadOS operates fully using deterministic regex/rule-based extraction.
GEMINI_API_KEY=

# Source Retrieval Safeguards
SOURCE_FETCH_TIMEOUT_SECONDS=8
MAX_SOURCE_BYTES=2097152
MAX_CONCURRENT_FETCHES=5
